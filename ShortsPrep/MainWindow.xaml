<Window x:Class="ShortsPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShortsPrep — Tututte" Height="640" Width="820"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="ShortsPrep" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="FfmpegVersionText" Text="  (ffmpeg : ...)" FontSize="14"
                       Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
        </StackPanel>

        <!-- Sélection du fichier -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BrowseButton" Content="Choisir une vidéo..." Padding="12,6" Click="BrowseButton_Click"/>
                <TextBlock x:Name="SelectedFileText" Text="Aucun fichier sélectionné"
                           Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Options qualité -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Qualité vidéo" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="QualityVisualLossless" Content="Visuellement sans perte (recommandé)"
                                 Foreground="{StaticResource TextBrush}" IsChecked="True" GroupName="Quality" Margin="0,0,20,0"/>
                    <RadioButton x:Name="QualityTrueLossless" Content="100% sans perte (fichiers très volumineux)"
                                 Foreground="{StaticResource TextBrush}" GroupName="Quality" Margin="0,0,20,0"/>
                    <RadioButton x:Name="QualityCopy" Content="Copier si déjà compatible (le plus rapide)"
                                 Foreground="{StaticResource TextBrush}" GroupName="Quality"/>
                </StackPanel>
                <Separator Margin="0,12"/>
                <TextBlock Text="Audio d'origine (copie maître, aucune perte)" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ExtractAudioCheck" Content="Extraire une copie audio sans perte" IsChecked="True"
                              Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                    <RadioButton x:Name="AudioWav" Content="WAV (24-bit)" Foreground="{StaticResource TextBrush}"
                                 IsChecked="True" GroupName="AudioFormat" Margin="0,0,20,0"/>
                    <RadioButton x:Name="AudioFlac" Content="FLAC" Foreground="{StaticResource TextBrush}" GroupName="AudioFormat"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Plateformes -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Plateformes à préparer" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="TikTokCheck" Content="TikTok" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                    <CheckBox x:Name="InstagramCheck" Content="Instagram Reels" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                    <CheckBox x:Name="YoutubeCheck" Content="YouTube Shorts" IsChecked="True" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Journal -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontFamily="Consolas"/>
            </ScrollViewer>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ProcessButton" Content="Traiter et préparer" Padding="20,10" FontWeight="Bold"
                    Background="{StaticResource AccentBrush}" Foreground="White" Click="ProcessButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
