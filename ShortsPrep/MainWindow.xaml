<Window x:Class="ShortsPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShortsPrep — Tututte" Height="820" Width="860"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="ShortsPrep" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="FfmpegVersionText" Text="  (ffmpeg : ...)" FontSize="14"
                       Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
        </StackPanel>

        <!-- Mode source -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="ModeVideoRadio" Content="Depuis une vidéo existante" GroupName="Mode"
                                 Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,0,24,0"
                                 Checked="ModeRadio_Changed"/>
                    <RadioButton x:Name="ModeImageAudioRadio" Content="Depuis une image + un son"
                                 GroupName="Mode" Foreground="{StaticResource TextBrush}"
                                 Checked="ModeRadio_Changed"/>
                </StackPanel>

                <!-- Mode vidéo -->
                <StackPanel x:Name="VideoModePanel" Orientation="Horizontal">
                    <Button x:Name="BrowseButton" Content="Choisir une vidéo..." Padding="12,6" Click="BrowseButton_Click"/>
                    <TextBlock x:Name="SelectedFileText" Text="Aucun fichier sélectionné"
                               Foreground="{StaticResource SubTextBrush}" Margin="12,0,12,0" VerticalAlignment="Center"/>
                    <Button x:Name="TrimVideoButton" Content="Rogner / sélectionner une partie..." Padding="10,6"
                            Click="TrimVideoButton_Click" IsEnabled="False"/>
                    <TextBlock x:Name="VideoTrimText" Text="" Foreground="{StaticResource AccentBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mode image + audio -->
                <StackPanel x:Name="ImageAudioModePanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BrowseImageButton" Content="Choisir une image..." Padding="12,6" Click="BrowseImageButton_Click"/>
                        <TextBlock x:Name="SelectedImageText" Text="Aucune image sélectionnée"
                                   Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BrowseAudioButton" Content="Choisir un son..." Padding="12,6" Click="BrowseAudioButton_Click"/>
                        <TextBlock x:Name="SelectedAudioText" Text="Aucun son sélectionné"
                                   Foreground="{StaticResource SubTextBrush}" Margin="12,0,12,0" VerticalAlignment="Center"/>
                        <Button x:Name="TrimAudioButton" Content="Rogner..." Padding="10,6" Click="TrimAudioButton_Click" IsEnabled="False"/>
                        <TextBlock x:Name="AudioTrimText" Text="" Foreground="{StaticResource AccentBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="FlacMasterCheck" Content="Créer aussi un fichier maître 100% sans perte (image + audio FLAC intégré, .mkv)"
                              Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,4,0,4"/>

                    <Separator Margin="0,8"/>
                    <TextBlock Text="Méthode simple (commande directe, audio copié sans ré-encodage)"
                               Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="ChooseSimpleOutputButton" Content="Choisir le nom du fichier..." Padding="12,6"
                                Click="ChooseSimpleOutputButton_Click" Margin="0,0,12,0"/>
                        <TextBlock x:Name="SimpleOutputText" Text="Aucun fichier de sortie choisi"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="StartSimpleCombineButton" Content="Démarrer" Padding="16,8" FontWeight="Bold"
                            Background="{StaticResource AccentBrush}" Foreground="White" HorizontalAlignment="Left"
                            IsEnabled="False" Click="StartSimpleCombineButton_Click"/>
                    <TextBlock Text="La vidéo générée durera exactement la durée du son (max 60s en portrait, illimité en paysage/maître)."
                               Foreground="{StaticResource SubTextBrush}" FontStyle="Italic" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Options qualité -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Format de sortie" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="OrientationPortrait" Content="Portrait 9:16 — short (TikTok / Reels / YouTube Shorts, même format)"
                                 Foreground="{StaticResource TextBrush}" IsChecked="True" GroupName="Orientation" Margin="0,0,20,0"
                                 Checked="OrientationRadio_Changed"/>
                    <RadioButton x:Name="OrientationLandscape" Content="Paysage 16:9 (format classique)"
                                 Foreground="{StaticResource TextBrush}" GroupName="Orientation" Checked="OrientationRadio_Changed"/>
                </StackPanel>
                <Separator Margin="0,0,0,12"/>
                <TextBlock Text="Qualité vidéo" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="QualityVisualLossless" Content="Visuellement sans perte (recommandé)"
                                 Foreground="{StaticResource TextBrush}" IsChecked="True" GroupName="Quality" Margin="0,0,20,0"/>
                    <RadioButton x:Name="QualityTrueLossless" Content="100% sans perte (fichiers très volumineux)"
                                 Foreground="{StaticResource TextBrush}" GroupName="Quality" Margin="0,0,20,0"/>
                    <RadioButton x:Name="QualityCopy" Content="Copier si déjà compatible (le plus rapide)"
                                 Foreground="{StaticResource TextBrush}" GroupName="Quality"/>
                </StackPanel>
                <Separator Margin="0,12"/>
                <TextBlock Text="Audio d'origine (copie maître, aucune perte)" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ExtractAudioCheck" Content="Extraire une copie audio sans perte" IsChecked="True"
                              Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                    <RadioButton x:Name="AudioWav" Content="WAV (24-bit)" Foreground="{StaticResource TextBrush}"
                                 IsChecked="True" GroupName="AudioFormat" Margin="0,0,20,0"/>
                    <RadioButton x:Name="AudioFlac" Content="FLAC" Foreground="{StaticResource TextBrush}" GroupName="AudioFormat"/>
                </StackPanel>
                <Separator Margin="0,12"/>
                <TextBlock Text="Mouvement de caméra et réactivité à la musique (s'applique aussi à une vidéo existante, même en portrait)"
                           Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <CheckBox x:Name="KenBurnsCheck" Content="Mouvement de caméra (zoom lent + léger travelling, façon Ken Burns)"
                          Foreground="{StaticResource TextBrush}" Checked="MotionCheck_Changed" Unchecked="MotionCheck_Changed"/>
                <StackPanel x:Name="KenBurnsIntensityPanel" Orientation="Horizontal" Margin="20,2,0,6" Visibility="Collapsed">
                    <TextBlock Text="Intensité :" Foreground="{StaticResource SubTextBrush}" Width="70" VerticalAlignment="Center"/>
                    <Slider x:Name="KenBurnsIntensitySlider" Minimum="0" Maximum="100" Value="50" Width="220"/>
                </StackPanel>
                <CheckBox x:Name="BassReactiveCheck" Content="Le zoom réagit aux basses (pulsation sur les kicks/basses détectées)"
                          Foreground="{StaticResource TextBrush}" Checked="MotionCheck_Changed" Unchecked="MotionCheck_Changed"/>
                <StackPanel x:Name="BassSensitivityPanel" Orientation="Horizontal" Margin="20,2,0,4" Visibility="Collapsed">
                    <TextBlock Text="Sensibilité :" Foreground="{StaticResource SubTextBrush}" Width="70" VerticalAlignment="Center"/>
                    <Slider x:Name="BassSensitivitySlider" Minimum="0" Maximum="100" Value="60" Width="220"/>
                </StackPanel>
                <TextBlock Text="Analyse l'énergie des basses de l'audio (pas une détection de rythme/BPM parfaite : ça pulse fort sur les kicks/basses marquées)."
                           Foreground="{StaticResource SubTextBrush}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Publication -->
        <Border x:Name="PublishBorder" Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Ouvrir pour publier après génération (un seul fichier .mp4 sert pour les trois, même format)"
                           Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="TikTokCheck" Content="TikTok" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                    <CheckBox x:Name="InstagramCheck" Content="Instagram Reels" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                    <CheckBox x:Name="YoutubeCheck" Content="YouTube Shorts" IsChecked="True" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Emplacement de sortie -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dossier de sortie :" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="ChooseOutputButton" Content="Choisir..." Padding="12,6" Click="ChooseOutputButton_Click"/>
                <TextBlock x:Name="OutputDirText" Text="(par défaut : à côté du fichier source)"
                           Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Journal -->
        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" FontFamily="Consolas"/>
            </ScrollViewer>
        </Border>

        <!-- Barre de progression -->
        <StackPanel Grid.Row="6" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ProgressBarCtrl" Grid.Column="0" Height="10" Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="" Foreground="{StaticResource TextBrush}"
                           FontWeight="Bold" Margin="10,0,0,0" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenOutputButton" Content="Ouvrir le dossier de sortie" Padding="14,10" Margin="0,0,10,0"
                    Click="OpenOutputButton_Click" IsEnabled="False"/>
            <Button x:Name="ProcessButton" Content="Traiter et préparer" Padding="20,10" FontWeight="Bold"
                    Background="{StaticResource AccentBrush}" Foreground="White" Click="ProcessButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
