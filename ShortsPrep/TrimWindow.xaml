<Window x:Class="ShortsPrep.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir la partie à garder" Height="560" Width="640"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choisis le début et la fin à conserver"
                   Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="Black" CornerRadius="6">
            <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Stretch="Uniform" MediaOpened="Media_MediaOpened"/>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Début" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
            <Slider x:Name="StartSlider" Minimum="0" Maximum="1" ValueChanged="StartSlider_ValueChanged"/>
            <TextBlock x:Name="StartLabel" Text="00:00.0" Foreground="{StaticResource SubTextBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Fin" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
            <Slider x:Name="EndSlider" Minimum="0" Maximum="1" ValueChanged="EndSlider_ValueChanged"/>
            <TextBlock x:Name="EndLabel" Text="00:00.0" Foreground="{StaticResource SubTextBrush}"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="DurationLabel" Text="Durée sélectionnée : 0.0s"
                   Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Lire l'aperçu" Padding="12,8" Margin="0,0,10,0" Click="PreviewButton_Click"/>
            <Button Content="Annuler" Padding="14,8" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Valider" Padding="18,8" FontWeight="Bold"
                    Background="{StaticResource AccentBrush}" Foreground="White" Click="ValidateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
