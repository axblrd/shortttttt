<Application x:Class="ShortsPrep.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#101014"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B1B22"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#ECECF1"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#9B9BA8"/>
    </Application.Resources>
</Application>
